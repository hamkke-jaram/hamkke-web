{
  "name": "hamkke-jaram-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-models": "node node_modules/@hamkke-jaram/analysis/scripts/prepare-models.mjs public",
    "dev": "npm run prepare-models && vite",
    "build": "npm run prepare-models && tsc -b && vite build",
